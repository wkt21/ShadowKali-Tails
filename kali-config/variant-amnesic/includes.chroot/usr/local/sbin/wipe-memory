#!/bin/bash
# Best-effort free-memory wipe on shutdown (cold-boot mitigation)
set -euo pipefail
echo "Starting free memory wipe…"
sync
echo 3 > /proc/sys/vm/drop_caches || true
# Use secure-delete if available, otherwise a simple dd loop
if command -v sdmem >/dev/null; then
    sdmem -llv
else
    # Allocate and free large chunks of RAM (kernel poisoning helps)
    python3 -c '
import os, mmap, resource
resource.setrlimit(resource.RLIMIT_AS, (resource.RLIM_INFINITY, resource.RLIM_INFINITY))
chunks = []
try:
    while True:
        chunks.append(mmap.mmap(-1, 64*1024*1024))
except:
    pass
print("Allocated", len(chunks)*64, "MiB")
' || true
fi
echo "Memory wipe pass finished."
