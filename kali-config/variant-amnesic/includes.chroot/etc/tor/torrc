# ShadowKali-Tails – forced Tor (amnesic live system)
# =====================================================
User debian-tor
DataDirectory /var/lib/tor
PidFile /run/tor/tor.pid

# SOCKS (localhost only)
SocksPort 9050 IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort
SocksPolicy accept 127.0.0.1
SocksPolicy reject *

# Transparent proxy + DNS
TransPort 127.0.0.1:9040 IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort
DNSPort 127.0.0.1:5353
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 10.192.0.0/10
VirtualAddrNetworkIPv6 [FC00::]/7

# Circuit preferences (still safe)
CircuitBuildTimeout 10
LearnCircuitBuildTimeout 0
MaxCircuitDirtiness 600

# Reduce potential leaks
DisableDebuggerAttachment 1
SafeLogging 1

############### Onion Service (v3, ephemeral by default) ###############
# Keys live under HiddenServiceDir.
# On pure amnesic boots this is in RAM and disappears on shutdown.
# When encrypted persistence is present the helper bind-mounts a
# persistent location over this path (see shadowkali-onion-persist).

HiddenServiceDir /var/lib/tor/shadowkali_hs/
HiddenServiceVersion 3

# Prefer Unix socket (avoids local TCP listener that could leak)
HiddenServicePort 80 unix:/run/tor/shadowkali_hs.sock

# Alternative TCP backend (uncomment only if your application cannot use a socket)
# HiddenServicePort 80 127.0.0.1:8080

# Optional extra services
# HiddenServicePort 22 127.0.0.1:22
