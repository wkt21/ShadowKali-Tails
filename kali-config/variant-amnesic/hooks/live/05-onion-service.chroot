#!/bin/bash
set -euo pipefail

HS_DIR="/var/lib/tor/shadowkali_hs"
SOCK_DIR="/run/tor"

mkdir -p "$HS_DIR"
mkdir -p "$SOCK_DIR"

# Strict ownership & permissions (critical for Tor)
chown -R debian-tor:debian-tor "$HS_DIR"
chmod 700 "$HS_DIR"

chown debian-tor:debian-tor "$SOCK_DIR"
chmod 755 "$SOCK_DIR"

# The actual Unix socket is created by Tor itself at runtime
